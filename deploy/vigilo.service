[Unit]
Description=Vigilo Security Daemon
Documentation=https://github.com/voltagebots/vigilo
After=network.target
Wants=network.target

[Service]
Type=simple
User=vigilo
Group=vigilo
# Secrets (VIGILO_MCP_TOKEN, VIGILO_WEB_TOKEN, alert credentials) live here,
# mode 0600 owned by vigilo, so they never appear in config files or the unit.
# The leading "-" keeps the service startable before the file exists.
EnvironmentFile=-/etc/vigilo/env
ExecStart=/usr/local/bin/vigilo \
    -config /etc/vigilo/config.yaml \
    -db /var/lib/vigilo/events.db
Restart=always
RestartSec=5

# Harden the service — it only needs to read watched paths and write to its db
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/vigilo
ReadOnlyPaths=/etc/vigilo
# Allow reading watched paths (add your app dirs here if not under /home or /run)
ReadOnlyPaths=/home /run/secrets /app

CapabilityBoundingSet=
AmbientCapabilities=

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vigilo

[Install]
WantedBy=multi-user.target
