ANTHROPIC_API_KEY=sk-ant-...
SLACK_BOT_TOKEN=xoxb-...
VIGILO_ALERT_CHANNEL=C0XXXXXXX

# Scan every 5 minutes (cron syntax)
SCAN_CRON=*/5 * * * *

# How many minutes back to pull events each scan
LOOKBACK_MINUTES=6

# Signal dedup cooldown in ms (default 3600000 = 1 hour)
# SIGNAL_COOLDOWN_MS=3600000

# ── Single daemon (pick one) ──────────────────────────────────────────────────

# Option A: stdio — agent spawns vigilo as a child process (local only)
VIGILO_DAEMON_BIN=vigilo
VIGILO_CONFIG=/etc/vigilo/config.yaml

# Option B: single remote daemon over SSE/HTTP
# VIGILO_MCP_URL=http://100.64.0.1:7070

# Bearer token for the daemon's MCP HTTP transport (mcp_token / VIGILO_MCP_TOKEN
# on the daemon side). Required whenever the daemon sets one.
# VIGILO_MCP_TOKEN=...

# ── Multi-daemon (multiple servers via Tailscale / WireGuard) ─────────────────
# Comma-separated label=url pairs. Takes precedence over the single-daemon vars.
# VIGILO_DAEMON_URLS=validator-1=http://100.64.0.1:7070,signer-1=http://100.64.0.2:7070,bridge=http://100.64.0.3:7070
